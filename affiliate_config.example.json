{
  "utm": {
    "utm_source": "my-site",
    "utm_medium": "affiliate",
    "utm_campaign": "{domain}"
  },
  "programs": {
    "amazon.com": {
      "network": "Amazon Associates",
      "params": {
        "tag": "YOUR-AMAZON-TAG-20"
      },
      "commission_rate": 0.03,
      "commission_verified": false,
      "commission_source": "set true only after checking your Associates dashboard"
    },
    "example-awin-merchant.com": {
      "network": "Awin",
      "template": "https://www.awin1.com/cread.php?awinmid=MERCHANT_ID&awinaffid=YOUR_AFFILIATE_ID&ued={url_encoded}",
      "commission_rate": 0.06,
      "commission_verified": true,
      "commission_source": "Awin programme terms, checked 2026-11-01"
    },
    "example-impact-merchant.com": {
      "network": "Impact",
      "template": "https://example.sjv.io/c/YOUR_ID/CAMPAIGN_ID/ADID?u={url_encoded}"
    },
    "example-shopify-store.com": {
      "params": {
        "ref": "YOUR_REF_CODE"
      }
    },
    "example-israeli-store.co.il": {
      "network": "in-house",
      "params": {
        "ref": "YOUR_PARTNER_ID"
      },
      "commission_rate": 0.08,
      "commission_verified": false,
      "commission_source": "set true after confirming the rate in your partner agreement"
    }
  },
  "audience": {
    "keywords": [
      "coffee",
      "kettle",
      "קפה"
    ],
    "categories": [
      "Kitchen",
      "מטבח"
    ]
  },
  "only_affiliated": false,
  "_comment": "Amazon Creators API and AliExpress Affiliate API return ready affiliate links (and AliExpress the commission rate), so they need no entry here. Use programs for Israeli stores / networks."
}